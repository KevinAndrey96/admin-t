{
    "name": "kevinandrey96/php-woocommerce-admin-panel",
    "description": "Back-office panel for WooCommerce stores over the official REST API: orders, products and sales, in framework-free PHP 8.3+.",
    "type": "project",
    "license": "proprietary",
    "keywords": ["php", "woocommerce", "wordpress", "admin-panel", "rest-api", "ecommerce", "back-office"],
    "authors": [
        {
            "name": "Kevin Andrey Herrera Silva",
            "email": "kahs_kevin@hotmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-sodium": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "WooPanel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WooPanel\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "php-cs-fixer check --diff",
        "fix": "php-cs-fixer fix",
        "check": ["@lint", "@analyse", "@test"]
    }
}
