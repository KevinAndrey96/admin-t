# Store whose REST API the panel calls (from the panel server's point of view)
WOOCOMMERCE_URL=https://tienda.example.com
# Public address of the store, for links and product images (defaults to WOOCOMMERCE_URL)
WOOCOMMERCE_PUBLIC_URL=
STORE_NAME=Mi tienda

# 32 random bytes in base64 that encrypt the credential kept in the session: `make key`
APP_KEY=
APP_TIMEZONE=America/Bogota
# false only for local development over plain http
APP_SECURE_COOKIES=true
# true only behind a reverse proxy that sets X-Forwarded-Proto
APP_TRUST_PROXY=false
# Sessions and login throttling; use shared storage when running several replicas
APP_STORAGE=

# Local Docker stack only
DB_PASSWORD=local-only
